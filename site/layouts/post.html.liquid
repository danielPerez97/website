<!DOCTYPE html>

<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{{ page.title }} - Daniel Perez</title>
		<link rel="stylesheet" href="/static/bootstrap-3.1.1.min.css" type="text/css">
		<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Merriweather+Sans:400,300,700" type="text/css">
		<link rel="stylesheet" href="/static/app.css" type="text/css">
		<link rel="stylesheet" href="/static/nord.css" type="text/css">
		<link type="application/atom+xml" rel="alternate" href="{{ site.url }}/atom.xml" />
		<meta name="theme-color" content="#111111">
		<meta name="fediverse:creator" content="@danielperez@androiddev.social" />
		<meta name="og:type" content="article">
		<meta name="og:title" content="{{ page.title }} – Daniel Perez">
		<meta name="og:description" content="{{ page.lead }}">
		<meta name="og:site_name" content="Daniel Perez">
		<meta name="og:url" content="{{ site.url }}{{ page.url }}">
		<meta property="article:published_time" content="{{ page.date | date: "%Y-%m-%d" }}">
	</head>
	<body>
		<header class="header-content">
			{{ header-content }}
		</header>

		<div class="content post">
			<h2>{{ page.title }}</h2>
			<p class="date">{{ page.date | date:"%d %B %Y" }}</p>

			{{ content }}

			<p class="signature">&mdash; Daniel Perez</p>
		</div>
	</body>
</html>
